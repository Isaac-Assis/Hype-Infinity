# Valores FICTÍCIOS. Copie para .env.local e preencha com os dados reais. Nunca faça commit do .env.local.
# Estas três variáveis são lidas só no servidor (não vão para o navegador).
SITE_URL=http://localhost:3000
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=chave-anon-ficticia

# SOMENTE para rodar scripts/provision-admin.mjs na sua máquina. NÃO configure na Vercel.
SUPABASE_SERVICE_ROLE_KEY=chave-service-role-ficticia
